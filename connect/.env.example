# Water Connect configuration. Copy to connect/.env and fill in. Never commit .env.

# --- Server secrets (generate fresh values; see README) ---
# WATER_DEMO=0 refuses to start without both private secrets below.
# Keep the master key stable: changing it prevents reading existing device keys.
WATER_SESSION_SECRET=
WATER_MASTER_KEY=            # urlsafe-base64 of 32 random bytes; encrypts device keys at rest

# --- Nicrron (AI answers) ---
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_MODEL=mistral/ministral-8b

# --- PRISM / Block Convey (traces, guardrail, evaluator, knowledge base) ---
PRISM_API_KEY=               # custom-purpose key: send + read
PRISM_PROJECT=TeamWater
PRISM_HOST=https://prism.blockconvey.com
PRISM_PROJECT_ID=             # UUID from PRISM: Settings -> Project

# --- Behaviour ---
AI_PROVIDER=mock             # mock | nicrron
GATEWAY_POLICY=group         # group = only members of the asker's group relay; any = any connected device
CLAIM_TTL_SECONDS=120
GROUP_DAILY_BUDGET=50        # AI calls per group per day
WATER_DB_PATH=connect/water_connect.db
ALLOWED_RETURN_SCHEMES=water,http://localhost,http://127.0.0.1
PRISM_EVALUATE=0            # 1 = score every shortened answer with the PRISM evaluator (costs credits)

# --- Demo ---
WATER_DEMO=1                 # one shared TeamWater account (team@water.demo) with every simulated node connected
WATER_DEMO_PASSWORD=teamwater
REQUIRE_GROUNDING=0          # 1 = field-guide answers only; 0 = model answers uncovered questions, labelled as general knowledge
