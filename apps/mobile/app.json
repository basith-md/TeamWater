{
  "expo": {
    "name": "TeamWater",
    "slug": "teamwater",
    "scheme": "teamwater",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teamwater.mesh",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.teamwater.mesh",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow TeamWater to record a short voice message for your teammate.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "12bc6cfe-8f05-43f8-8381-14401575cff8"
      }
    },
    "owner": "ravejedii",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/12bc6cfe-8f05-43f8-8381-14401575cff8"
    },
    "githubUrl": "https://github.com/shravanthi-m/TeamWater"
  }
}
