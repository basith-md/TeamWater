{
  "name": "teamwater", "version": "0.1.0", "private": true, "type": "module",
  "workspaces": ["apps/*", "packages/*", "shippable/*"],
  "scripts": {
    "dev": "npm run dev --workspace @teamwater/console",
    "serve": "npm run build --workspace @teamwater/console && env -u PYTHONPATH .venv/bin/uvicorn service.service:app --host 0.0.0.0 --port 8000",
    "mobile": "npm run start --workspace @teamwater/mobile",
    "mobile:web": "npm run web --workspace @teamwater/mobile",
    "test": "vitest run", "test:watch": "vitest",
    "check:expo-go": "node scripts/check-expo-go.mjs",
    "publish:preview": "npm run check:expo-go && npm run typecheck && npm test && npm run publish:preview --workspace @teamwater/mobile --",
    "typecheck": "tsc --noEmit", "build": "npm run build --workspace @teamwater/console",
    "test:e2e": "playwright test",
    "demo:record": "TEAMWATER_PIPELINE_URL=http://127.0.0.1:8003 playwright test tests/e2e/playa.spec.ts --headed",
    "demo:ledger": "env -u PYTHONPATH .venv/bin/python -u scripts/packet-ledger.py",
    "test:live": "TEAMWATER_LIVE_URL=http://127.0.0.1:8000 vitest run tests/integration/live-backend.test.ts",
    "test:pipeline": "vitest run tests/integration/pipeline-backend.test.ts"
  },
  "dependencies": {"react": "19.2.3", "react-dom": "19.2.3"},
  "devDependencies": {
    "typescript": "~6.0.3", "vitest": "^5.0.3", "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.0.1", "@types/react": "~19.2.2", "@types/react-dom": "~19.2.2",
    "@types/node": "^22.19.0", "@testing-library/react": "^16.3.3", "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1", "jsdom": "^27.0.1", "@playwright/test": "^1.64.0"
  }
}
